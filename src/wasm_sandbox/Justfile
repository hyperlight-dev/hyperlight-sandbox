set windows-shell := ["pwsh", "-NoLogo", "-Command"]

default-target := "debug"
repo-root := invocation_directory_native()
export WIT_WORLD := repo-root + "/src/wasm_sandbox/wit/sandbox-world.wasm"
rmrf := if os() == "windows" { "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue" } else { "rm -rf" }

ensure-tools:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py tools

guest-build-wasm:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py python

guest-compile-wit:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py wit

# Build portable x86-64 guests once for Linux and Windows consumers.
guest-bundle:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py all

# Include resolved compiler versions in immutable CI cache keys.
guest-cache-keys:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py cache-keys

# Reject artifacts produced from different guest sources or WIT interfaces.
guest-verify:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py verify

# Invalidate cargo caches that embed the WIT signature.
# Without this, cargo won't detect that sandbox-world.wasm changed
# and SDKs will fail at runtime with "vector parameter missing length".
# Also cleans hyperlight-host artifacts + hls/ surrogate dir to avoid
# inconsistent state on Windows after partial cache restore.
invalidate-wit-caches:
    -{{rmrf}} {{repo-root}}/target/hyperlight-wasm-runtime
    -{{rmrf}} {{repo-root}}/target/hls
    -{{rmrf}} {{repo-root}}/target/debug/build/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/target/debug/.fingerprint/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/target/debug/build/hyperlight-host-*
    -{{rmrf}} {{repo-root}}/target/debug/.fingerprint/hyperlight-host-*
    -{{rmrf}} {{repo-root}}/target/release/build/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/target/release/.fingerprint/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/target/release/build/hyperlight-host-*
    -{{rmrf}} {{repo-root}}/target/release/.fingerprint/hyperlight-host-*
    -{{rmrf}} {{repo-root}}/src/sdk/python/wasm_backend/target/hyperlight-wasm-runtime
    -{{rmrf}} {{repo-root}}/src/sdk/python/wasm_backend/target/debug/build/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/src/sdk/python/wasm_backend/target/debug/.fingerprint/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/src/sdk/python/wasm_backend/target/release/build/hyperlight-wasm-*
    -{{rmrf}} {{repo-root}}/src/sdk/python/wasm_backend/target/release/.fingerprint/hyperlight-wasm-*

# Only clean when rust-cache left stale state (fingerprints exist but runtime binary missing).
[unix]
_clean-stale-wasm:
    #!/usr/bin/env bash
    for profile in debug release; do
        if compgen -G "{{repo-root}}/target/$profile/build/hyperlight-wasm-*" > /dev/null && \
           [ ! -f "{{repo-root}}/target/hyperlight-wasm-runtime/x86_64-hyperlight-none/$profile/hyperlight-wasm-runtime" ]; then
            echo "Cleaning stale hyperlight-wasm $profile build artifacts..."
            rm -rf {{repo-root}}/target/hyperlight-wasm-runtime {{repo-root}}/target/hls \
                   {{repo-root}}/target/*/build/hyperlight-wasm-* {{repo-root}}/target/*/.fingerprint/hyperlight-wasm-* \
                   {{repo-root}}/target/*/build/hyperlight-host-* {{repo-root}}/target/*/.fingerprint/hyperlight-host-* \
                   {{repo-root}}/src/sdk/python/wasm_backend/target/hyperlight-wasm-runtime \
                   {{repo-root}}/src/sdk/python/wasm_backend/target/*/build/hyperlight-wasm-* \
                   {{repo-root}}/src/sdk/python/wasm_backend/target/*/.fingerprint/hyperlight-wasm-*
            break
        fi
    done

[windows]
_clean-stale-wasm:
    foreach ($profile in @('debug', 'release')) { \
        $bp = '{{repo-root}}/target/' + $profile + '/build'; \
        $rp = '{{repo-root}}/target/hyperlight-wasm-runtime/x86_64-hyperlight-none/' + $profile + '/hyperlight-wasm-runtime'; \
        if ((Get-ChildItem -Path $bp -Filter 'hyperlight-wasm-*' -ErrorAction SilentlyContinue) -and \
            -not (Test-Path $rp)) { \
            Write-Host ('Cleaning stale hyperlight-wasm ' + $profile + ' build artifacts...'); \
            Remove-Item -Recurse -Force -ErrorAction SilentlyContinue '{{repo-root}}/target/hyperlight-wasm-runtime','{{repo-root}}/target/hls'; \
            foreach ($t in @('{{repo-root}}/target', '{{repo-root}}/src/sdk/python/wasm_backend/target')) { \
                foreach ($p in @('debug', 'release')) { \
                    $bd = "$t/$p/build"; $fd = "$t/$p/.fingerprint"; \
                    if (Test-Path $bd) { Get-ChildItem -Path $bd -Filter 'hyperlight-wasm-*' -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force; \
                                         Get-ChildItem -Path $bd -Filter 'hyperlight-host-*' -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force }; \
                    if (Test-Path $fd) { Get-ChildItem -Path $fd -Filter 'hyperlight-wasm-*' -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force; \
                                         Get-ChildItem -Path $fd -Filter 'hyperlight-host-*' -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force }; \
                }; \
            }; \
            break; \
        } \
    }

guest-build-aot target=default-target: guest-build-wasm

guest-build target=default-target: (guest-build-wasm) (guest-compile-wit) (guest-build-aot target)

js-guest-build-wasm: (js-guest-install)

js-guest-build-aot: js-guest-build-wasm

js-guest-build: js-guest-build-wasm js-guest-build-aot

js-guest-install:
    uv run --no-project --python 3.14 python {{repo-root}}/scripts/guest_build.py javascript

# Test componentization against the installed JavaScript dependencies.
js-guest-test:
    cd {{repo-root}}/src/wasm_sandbox/guests/javascript && npm ci
    cd {{repo-root}}/src/wasm_sandbox/guests/javascript && npm test

build target=default-target: _clean-stale-wasm (guest-build target) (js-guest-build)
    cargo build --manifest-path {{repo-root}}/src/wasm_sandbox/Cargo.toml --profile={{ if target == "debug" {"dev"} else { target } }}

